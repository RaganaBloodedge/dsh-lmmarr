{
  "name": "dsh-lmmarr",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：分层任务记忆 + 关系图谱 + 热记忆常驻投影（lmmArr）",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "agent-memory",
    "long-term-memory",
    "persistent-memory",
    "memory-orchestration",
    "project-memory",
    "context-management",
    "knowledge-graph",
    "task-graph",
    "local-first"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-declaration-imports.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:name": "node scripts/verify-package-name.mjs",
    "verify:mount": "dsh --profile headless --patch ./scripts/mount-probe/patch.yml probe",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify && npm run verify:name",
    "memory:index": "node src/memory/cli.ts index .workbuddy/memory",
    "memory:check": "node src/memory/cli.ts check .workbuddy/memory",
    "sync:skill": "node scripts/sync-skill.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "validate-npm-package-name": "^6.0.2"
  }
}
